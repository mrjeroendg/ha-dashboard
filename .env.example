# Copy this file to .env.local (gitignored) and fill in your own values.
# Only used by `npm run dev` and `npm run deploy` — never bundled into ha-dashboard.js.

# Home Assistant base URL (reachable from the PC running `npm run dev`)
VITE_HA_URL=http://192.168.1.100:8123

# Long-lived access token: HA → your profile → Security → Long-lived access tokens
VITE_HA_TOKEN=paste-your-token-here

# Where `npm run deploy` copies the bundle. With the Samba share add-on on Windows:
HA_WWW_PATH=\\192.168.1.100\config\www
